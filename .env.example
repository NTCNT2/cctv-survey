# Copy to .env and fill in real values. NEVER commit .env.
# Values below are placeholders only.

# ---- PostgreSQL / PostGIS (Phase 3) ----
POSTGRES_DB=cctv_survey
POSTGRES_USER=cctv
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cctv:change-me@127.0.0.1:5432/cctv_survey?schema=public

# ---- API (NestJS) ----
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ---- Uploads (site photos) ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# OpenStreetMap raster tiles by default; replace for production use
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_DEFAULT_CENTER=13.7563,100.5018
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
