# Copy to .env and fill in real values. NEVER commit .env.
# Values below are placeholders only.

# ---- PostgreSQL / PostGIS (Phase 3) ----
# Used by compose.yaml. The container port is always published on 127.0.0.1 only.
# Generate the password with: openssl rand -hex 24  (hex avoids URL-escaping in DATABASE_URL)
# The password is fixed when the volume is first initialised; changing it here later
# does NOT change it in the database (use ALTER ROLE ... PASSWORD inside psql).
POSTGRES_DB=cctv_survey
POSTGRES_USER=cctv
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# Host-side port (loopback only). Change if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cctv:change-me@127.0.0.1:5432/cctv_survey?schema=public

# ---- API (NestJS) ----
# Loopback only (127.0.0.1 / ::1 / localhost) — the API serves plain HTTP and refuses to
# start otherwise. Public access goes through the TLS reverse proxy (Phase 7).
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Auth (Phase 5) ----
# Required. At least 32 bytes of random data; the API refuses to start with a
# placeholder. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=change-me
# Session / token lifetime: 5m – 7d, e.g. 30m, 8h, 1d
JWT_EXPIRES_IN=8h
# Session cookie `Secure` flag. On unless set to exactly `false` (also in production).
# `false` here is for local http:// development; the prod container ignores .env and
# gets its value from compose.prod.yaml (currently 'false' TEMPORARILY for plain HTTP).
COOKIE_SECURE=false

# ---- Uploads (site photos) ----
# Photo files (JPEG + thumbnail) written by the API; the database keeps only
# their names. Relative paths resolve from the API's working directory. The
# prod container uses /data/uploads on the uploads_prod volume instead.
# Upload size is fixed in code (< 1 MB, the proxy limit): the web app shrinks
# photos before sending them.
UPLOAD_DIR=./data/uploads

# ---- Web (Next.js) ----
# The browser never calls the API directly: it uses same-origin /api/*, which
# Next.js forwards to API_INTERNAL_URL (server-side only, never sent to the
# browser). Next.js does not read this root .env — set it in the environment
# of `next build` if the API is not on the default http://127.0.0.1:4000.
# API_INTERNAL_URL=http://127.0.0.1:4000
# ---- Survey map (Google Maps JavaScript API) ----
# Read by the web server at request time (/projects/[id]/map), not at build
# time: change them in the web container's environment, no rebuild needed.
# Production needs both the key and the Map ID: without them, or if Google
# rejects the key, the map page shows a clear error (no switch to another map).
# `next dev` only: OpenStreetMap (Leaflet) stands in and DEMO_MAP_ID is allowed.
# Browser key: in Google Cloud restrict it by HTTP referrer (e.g.
# http://<WAN>:5580/* now, https://<host>/* later) and to the Maps JavaScript
# API only. Needs billing enabled. Never commit a real key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Advanced markers need a Map ID (Google Cloud > Map management).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Testing only (e2e): `true` gives a production build the development map
# fallback above. Never set it in production.
# SURVEY_MAP_DEV_FALLBACK=
# OpenStreetMap raster tiles (fallback map); replace for heavy production use
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_DEFAULT_CENTER=13.7563,100.5018
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# ---- Production containers (compose.prod.yaml, scripts/prod.sh) ----
# DATABASE_URL above stays the superuser `cctv` for host tools (migrate, psql, e2e).
# The prod API connects as the least-privilege role `cctv_app` (migration 0003);
# compose builds its URL without a password and passes this one as PGPASSWORD.
# Set it in the database first: `pnpm db:psql` then `\password cctv_app`.
# Generate with: openssl rand -hex 24
APP_DB_PASSWORD=change-me
# JWT secret for prod only (separate from JWT_SECRET). openssl rand -base64 48
PROD_JWT_SECRET=change-me
# Host name the site answers to. Step B (loopback, ssh -L 9443:127.0.0.1:9443): 127.0.0.1
PROD_SITE_HOST=182.53.52.192
# Let's Encrypt ACME directory for the public HTTPS site (empty = staging).
#   staging:    https://acme-staging-v02.api.letsencrypt.org/directory
#   production: https://acme-v02.api.letsencrypt.org/directory
ACME_CA=
# Browser origin of the site. Step B: https://127.0.0.1:9443
PROD_CORS_ORIGIN=https://127.0.0.1:9443
