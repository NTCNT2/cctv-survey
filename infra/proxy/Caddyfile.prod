# CCTV Survey reverse proxy — production (compose.prod.yaml, service prod-proxy).
# HTTPS: <WAN>:5443 -> 192.168.77.20:443 -> 8443 with a Let's Encrypt
# certificate for the public IP; 127.0.0.1:9443 -> 8443 (loopback) keeps the
# internal CA. HTTP: <WAN>:80 / :5580 -> 192.168.77.20:80 -> 8080 answers
# Let's Encrypt's HTTP-01 challenge and redirects everything else to
# {$PROD_PUBLIC_ORIGIN} (the public HTTPS address).
{
	# No admin API at all (the image exposes :2019 by default).
	admin off
	# Clients send no SNI for IP addresses; serve the public IP's certificate.
	default_sni {$PROD_SITE_HOST}
	# Unprivileged ports inside the container: no capabilities needed.
	http_port 8080
	https_port 8443
	# Never install Caddy's internal root into a trust store.
	skip_install_trust
	# Caddy's automatic redirects would point at :443, but users come in on
	# the NAT'd :5443; the :8080 site below redirects explicitly instead.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format json
	}
}

(app) {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		# Browsers ignore HSTS for IP-address hosts (RFC 6797 8.1), so this
		# protects nothing yet. Once there is a domain: 1 week, then 1 year
		# (never includeSubDomains/preload while the address is an IP).
		Strict-Transport-Security "max-age=300"
		-Server
		-Via
	}
	log
	# Only the web app is reachable; it forwards /api/* to prod-api on the
	# internal prod-app network. Caddy sets X-Forwarded-For to the real client
	# address and ignores client-sent X-Forwarded-* (no trusted_proxies).
	reverse_proxy prod-web:3000
}

# Public HTTPS: Let's Encrypt certificate for the IP address. Let's Encrypt
# issues IP certificates only with the short-lived profile (about 6 days);
# Caddy renews them automatically. Validation is HTTP-01 on public port 80
# (served on :8080 below); TLS-ALPN-01 is off because public :443 is not
# forwarded (users come in on :5443). ACME_CA: staging first, then production.
https://{$PROD_SITE_HOST}:8443 {
	tls {
		issuer acme {
			dir {$ACME_CA}
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	import app
}

# Loopback only (ssh -L 9443): Caddy's internal CA, as before.
https://127.0.0.1:8443 {
	tls internal
	import app
}

# Plain HTTP: router NAT <WAN>:80 and <WAN>:5580 -> 192.168.77.20:80,
# published as 192.168.77.20:80 -> 8080. Any Host header.
# - /.well-known/acme-challenge/*: Caddy's HTTP-01 solver answers known tokens
#   before any route here; unknown tokens get 404, never a redirect.
# - 127.0.0.1 (the container healthcheck): proxied to the app as before.
# - Everything else: 302 to the public HTTPS address. Not 301: the WAN IP is
#   dynamic and browsers cache permanent redirects.
http://:8080 {
	header {
		-Server
		-Via
	}
	log
	handle /.well-known/acme-challenge/* {
		respond 404
	}
	@healthcheck remote_ip 127.0.0.1
	handle @healthcheck {
		request_body {
			max_size 1MB
		}
		reverse_proxy prod-web:3000
	}
	handle {
		redir {$PROD_PUBLIC_ORIGIN}{uri} 302
	}
}
