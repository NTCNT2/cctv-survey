{
  "name": "cctv-survey",
  "version": "0.1.0",
  "private": true,
  "description": "CCTV Site Survey & Design system (Next.js + NestJS + PostGIS)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cctv/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @cctv/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "bash scripts/db.sh migrate",
    "db:status": "bash scripts/db.sh status",
    "db:verify": "bash scripts/db.sh verify",
    "db:psql": "bash scripts/db.sh psql",
    "db:test": "bash scripts/db.sh test-db",
    "user:create-admin": "pnpm --filter @cctv/api run create-admin"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.8.1"
}
